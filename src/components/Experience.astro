---
const EXPERIENCE = [
    {
        date: "Noviembre 2025 - Presente",
        title: "Desarrollador Full Stack",
        company: "Abarrotes Monterrey",
        description:
            "Desarrollo de módulos ERP personalizados enfocados en la gestión de inventarios, artículos, movimientos, requisiciones y órdenes de compra con control de acceso por roles.",
        link: "",
    },
    {
        date: "Octubre 2024 - Octubre 2025",
        title: "Desarrollador Full Stack",
        company: "Bimo",
        description:
            "Creación de aplicaciones web completas utilizando Astro, PHP, JavaScript, MySQL y Tailwind CSS, destacando sistemas de inventarios y juegos interactivos.",
        link: "",
    },
];
---

<ol class="relative border-s border-gray-800 ml-3 sm:ml-4">
    {EXPERIENCE.map((experience, index) => (
        <li class="mb-10 ms-6 transition-all duration-300 group">
            {/* Roadmap organic offset / styling */}
            <div class="absolute -left-[17px] flex items-center justify-center w-8 h-8 bg-[#121212] border border-gray-700 rounded-full ring-4 ring-[#121212] group-hover:scale-110 group-hover:border-gray-500 transition-transform">
                <div class="w-2.5 h-2.5 bg-gray-400 group-hover:bg-white rounded-full transition-colors" />
            </div>
            <div class="bg-transparent border border-gray-800 rounded-2xl p-5 sm:p-6 transition-all duration-300 group-hover:border-gray-700 group-hover:bg-white/[0.02] shadow-lg">
                <time class="mb-1 text-xs sm:text-sm font-normal leading-none text-gray-400">
                    {experience.date}
                </time>
                <h3 class="text-lg sm:text-xl font-bold text-[#f5f5f5] mt-2 flex items-center gap-2 flex-wrap">
                    <span>{experience.title}</span>
                    <span class="px-2.5 py-0.5 text-xs font-medium bg-white/10 border border-white/10 rounded-full text-[#f5f5f5]/90">
                        {experience.company}
                    </span>
                </h3>
                <p class="mb-4 text-sm sm:text-base font-normal text-gray-300/90 mt-2 leading-relaxed">
                    {experience.description}
                </p>
                {experience.link && experience.link !== "" && (
                    <a
                        href={experience.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-gray-300 bg-white/5 border border-gray-700 hover:bg-white/10 hover:text-white px-3 py-1.5 rounded-full transition"
                    >
                        Saber más
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="16"
                            height="16"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="lucide lucide-arrow-right"
                        >
                            <path d="M5 12h14" />
                            <path d="m12 5 7 7-7 7" />
                        </svg>
                    </a>
                )}
            </div>
        </li>
    ))}
</ol>

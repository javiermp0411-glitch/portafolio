---
import SuitCase from "./icons/SuitCase.astro";
import GitHub from "./icons/GitHub.astro";
import Link from "./icons/Link.astro";
import AstroIcon from "./icons/AstroIcon.astro";
import Tailwind from "./icons/Tailwind.astro";
import TypeScript from "./icons/TypeScript.astro";
import JavaScript from "./icons/JavaScript.astro";
import PHP from "./icons/Php.astro";
import MySQL from "./icons/MySQL.astro";
import Bootstrap from "./icons/Bootstrap.astro";
import React from "./icons/React.astro";
import Node from "./icons/Node.astro";
import At from "./icons/At.astro";

const TECH_ICONS: Record<string, any> = {
    Astro: AstroIcon,
    Tailwind: Tailwind,
    TypeScript: TypeScript,
    JavaScript: JavaScript,
    PHP: PHP,
    MySQL: MySQL,
    Bootstrap: Bootstrap,
    React: React,
    Node: Node,
};

import { getCollection } from "astro:content";

const projects = await getCollection("projects");

const sortedProjects = projects.sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<div class="flex flex-col gap-8">
    {sortedProjects.map((project) => {
        const { id, data } = project;
        const {
            title,
            description,
            active,
            company,
            pubDate,
            links,
            techstack,
            imgs,
        } = data;
        if (active === false) return null;

        const formattedDate = new Date(pubDate).toLocaleDateString("es-ES", {
            year: "numeric",
            month: "short",
        });

        return (
            <article class="flex flex-col space-y-3 bg-transparent border border-gray-800 rounded-2xl p-5 sm:p-6 transition-all duration-300 hover:border-gray-700 hover:bg-white/[0.03] shadow-lg">
                {/* Header: Title, Company & Date */}
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div>
                        <div class="flex items-center gap-2 flex-wrap mb-1">
                            <h2
                                transition:name={`title-${id}`}
                                class="text-lg sm:text-xl font-bold text-[#f5f5f5]"
                            >
                                {title}
                            </h2>
                            {company && (
                                <div class="flex items-center gap-1.5 text-sm text-gray-400">
                                    <span class="flex size-4 shrink-0 items-center justify-center text-gray-500 [&>svg]:size-4">
                                        <At aria-hidden="true" />
                                    </span>
                                    <span>{company}</span>
                                </div>
                            )}
                        </div>
                    </div>
                    <time class="text-xs text-gray-400 font-medium">
                        {formattedDate}
                    </time>
                </div>

                {/* Description */}
                <p class="text-sm text-gray-300/90 leading-relaxed">
                    {description}
                </p>

                {/* Landing/Main Image */}
                {imgs?.main && (
                    <div class="overflow-hidden rounded-xl border border-gray-800 my-2 cursor-pointer">
                        <a href={`/projects/${id}`} rel="noopener noreferrer">
                            <img
                                src={imgs.main.src}
                                alt={`Captura de pantalla de ${title}`}
                                class="w-full h-auto object-cover transition-transform duration-500 hover:scale-[1.02]"
                            />
                        </a>
                    </div>
                )}

                {/* Tech Stack & Links Footer */}
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-3 border-t border-gray-800/80">
                    {/* Tech stack: show the icon when available and a readable fallback otherwise. */}
                    <div class="flex items-center gap-2.5 flex-wrap">
                        {techstack.map((tech) => {
                            const IconComponent = TECH_ICONS[tech];
                            return (
                                <span
                                    class="flex min-h-10 min-w-10 items-center justify-center gap-2 rounded-xl border border-gray-700/60 bg-white/5 px-2.5 py-1.5 text-sm text-gray-300 transition-all duration-300 hover:scale-105 hover:border-gray-600 hover:bg-white/10 [&>svg]:size-6 [&>svg]:shrink-0"
                                    title={tech}
                                >
                                    {IconComponent ? (
                                        <IconComponent />
                                    ) : (
                                        <span>{tech}</span>
                                    )}
                                </span>
                            );
                        })}
                    </div>

                    {/* Links */}
                    <div class="flex items-center gap-3">
                        {links?.github && links.github !== "" && (
                            <a
                                href={links.github}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex items-center gap-2 rounded-full border border-gray-700 bg-white/5 px-3.5 py-2 text-sm font-medium text-gray-300 transition hover:bg-white/10 hover:text-white"
                            >
                                <GitHub class="size-4" />
                                Código
                            </a>
                        )}
                        {links?.demo && links.demo !== "" && (
                            <a
                                href={`/projects/${id}`}
                                class="flex items-center gap-2 rounded-full bg-white px-3.5 py-2 text-sm font-medium text-gray-900 shadow-sm transition hover:bg-gray-200"
                            >
                                <Link class="size-4" />
                                Ver detalles
                            </a>
                        )}
                    </div>
                </div>
            </article>
        );
    })}
</div>

---
import type { CollectionEntry } from "astro:content";
import Close from "./icons/Close.astro";

interface Props {
    deliverables: CollectionEntry<"projects">["data"]["deliverables"];
}

const { deliverables } = Astro.props;
---

<section
    id="deliverables"
    class="flex flex-col gap-6 border-t border-gray-800 pt-6"
>
    <header class="flex flex-wrap items-end justify-between gap-2">
        <div>
            <p class="mb-1 font-mono text-[11px] uppercase tracking-wider text-gray-500">
                Alcance del proyecto
            </p>
            <h2 class="text-xl font-semibold text-[#f5f5f5]">
                Entregables y módulos
            </h2>
        </div>
        <p class="text-xs text-gray-500">
            {deliverables.length} {deliverables.length === 1 ? "módulo" : "módulos"}
        </p>
    </header>

    <div class="grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2">
        {deliverables.map((item, index) => (
            <article class="min-w-0">
                <button
                    type="button"
                    class="deliverable-trigger group block w-full text-left"
                    data-deliverable={index}
                    aria-haspopup="dialog"
                    aria-controls="deliverable-viewer"
                    aria-label={`Ver detalles de ${item.title}`}
                >
                    <span class="relative block aspect-[16/10] overflow-hidden rounded-xl border border-gray-800 bg-[#0c0c0c] transition-colors duration-300 group-hover:border-gray-600">
                        {item.img && (
                            <img
                                src={item.img.src}
                                alt={`Vista de ${item.title}`}
                                width={item.img.width}
                                height={item.img.height}
                                loading="lazy"
                                decoding="async"
                                class="h-full w-full object-contain transition-opacity duration-200 group-hover:opacity-80"
                            />
                        )}
                        <span class="absolute right-3 bottom-3 rounded-full border border-white/15 bg-[#121212]/90 px-2.5 py-1 font-mono text-[10px] text-gray-300 opacity-0 backdrop-blur-sm transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
                            Ampliar
                        </span>
                    </span>

                    <span class="mt-4 block">
                        <span class="flex items-baseline gap-3">
                            <span class="shrink-0 font-mono text-[11px] text-gray-500">
                                {String(index + 1).padStart(2, "0")}
                            </span>
                            <h3 class="text-base font-semibold text-gray-200 transition-colors duration-200 group-hover:text-white">
                                {item.title}
                            </h3>
                        </span>
                        <span class="mt-2 block text-sm leading-relaxed text-gray-400">
                            {item.description}
                        </span>
                        <span class="mt-3 block font-mono text-[11px] uppercase tracking-wider text-gray-500 transition-colors duration-200 group-hover:text-gray-300">
                            Ver detalles <span aria-hidden="true">↗</span>
                        </span>
                    </span>
                </button>
            </article>
        ))}
    </div>

    <dialog
        id="deliverable-viewer"
        class="m-auto max-h-[90dvh] w-[min(calc(100%-2rem),72rem)] max-w-none overflow-hidden rounded-2xl border border-gray-700 bg-[#121212] p-0 text-gray-200 shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-sm"
        aria-labelledby="deliverable-dialog-title"
    >
        <div class="flex max-h-[90dvh] flex-col">
            <header class="flex shrink-0 items-center justify-between gap-4 border-b border-gray-800 px-5 py-4 sm:px-6">
                <p class="font-mono text-[11px] uppercase tracking-wider text-gray-400">
                    Detalle del entregable
                </p>
                <button
                    type="button"
                    class="deliverable-dialog-close -mr-2 flex size-9 cursor-pointer items-center justify-center rounded-full text-gray-400 transition-colors duration-200 hover:bg-white/5 hover:text-white"
                    aria-label="Cerrar detalles"
                >
                    <Close class="size-5" aria-hidden="true" />
                </button>
            </header>

            <div class="overflow-y-auto overscroll-contain">
                {deliverables.map((item, index) => (
                    <article
                        class="deliverable-detail"
                        data-deliverable-detail={index}
                        hidden={index !== 0}
                    >
                        <div class="p-4 sm:p-6">
                            {item.img && (
                                <img
                                    id={index === 0 ? "deliverable-dialog-image" : undefined}
                                    src={item.img.src}
                                    alt={`Vista ampliada de ${item.title}`}
                                    width={item.img.width}
                                    height={item.img.height}
                                    loading="lazy"
                                    decoding="async"
                                    class="max-h-[55dvh] w-full rounded-xl border border-gray-800 bg-[#0c0c0c] object-contain"
                                />
                            )}
                        </div>

                        <div class="px-5 pb-6 sm:px-6 sm:pb-8">
                            <p class="mb-2 font-mono text-[11px] uppercase tracking-wider text-gray-500">
                                {String(index + 1).padStart(2, "0")} / {String(deliverables.length).padStart(2, "0")}
                            </p>
                            <h3
                                id={index === 0 ? "deliverable-dialog-title" : undefined}
                                class="text-xl font-semibold text-white sm:text-2xl"
                            >
                                {item.title}
                            </h3>
                            <p class="mt-3 text-sm leading-relaxed text-gray-300 sm:text-base">
                                {item.description}
                            </p>

                            {item.metrics && item.metrics.length > 0 && (
                                <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-gray-800 bg-gray-800 sm:grid-cols-3">
                                    {item.metrics.map((metric) => (
                                        <div class="bg-[#161616] p-4">
                                            <dt class="text-xs leading-relaxed text-gray-400">
                                                {metric.label}
                                            </dt>
                                            <dd class="mt-1 text-lg font-semibold text-white">
                                                {metric.value}
                                            </dd>
                                        </div>
                                    ))}
                                </dl>
                            )}

                            {item.features && item.features.length > 0 && (
                                <div class="mt-6 border-t border-gray-800 pt-5">
                                    <h4 class="mb-4 text-sm font-semibold text-gray-200">
                                        Funcionalidades
                                    </h4>
                                    <ul class="grid gap-4 sm:grid-cols-2">
                                        {item.features.map((feature) => (
                                            <li class="text-sm leading-relaxed text-gray-400">
                                                {feature.title && (
                                                    <strong class="mb-1 block font-medium text-gray-200">
                                                        {feature.title}
                                                    </strong>
                                                )}
                                                {feature.description}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </div>

            {deliverables.length > 1 && (
                <footer class="flex shrink-0 items-center justify-between border-t border-gray-800 px-5 py-3 sm:px-6">
                    <button
                        type="button"
                        class="deliverable-previous cursor-pointer rounded-full px-3 py-2 text-sm text-gray-400 transition-colors duration-200 hover:bg-white/5 hover:text-white disabled:pointer-events-none disabled:opacity-30"
                    >
                        <span aria-hidden="true">←</span> Anterior
                    </button>
                    <button
                        type="button"
                        class="deliverable-next cursor-pointer rounded-full px-3 py-2 text-sm text-gray-400 transition-colors duration-200 hover:bg-white/5 hover:text-white disabled:pointer-events-none disabled:opacity-30"
                    >
                        Siguiente <span aria-hidden="true">→</span>
                    </button>
                </footer>
            )}
        </div>
    </dialog>
</section>

<style>
    .deliverable-trigger:focus-visible {
        outline: 2px solid #d1d5db;
        outline-offset: 6px;
        border-radius: 0.75rem;
    }

    #deliverable-viewer[open] {
        animation: deliverable-fade-in 200ms ease-out;
    }

    .deliverable-detail:not([hidden]) {
        animation: deliverable-fade-in 180ms ease-out;
    }

    @keyframes deliverable-fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        #deliverable-viewer[open],
        .deliverable-detail:not([hidden]) {
            animation: none;
        }
    }
</style>

<script>
    const dialog = document.getElementById("deliverable-viewer");
    if (dialog instanceof HTMLDialogElement) {
        const details = Array.from(
            dialog.querySelectorAll<HTMLElement>("[data-deliverable-detail]"),
        );
        const triggers = document.querySelectorAll<HTMLButtonElement>(
            ".deliverable-trigger",
        );
        const previousButton = dialog.querySelector<HTMLButtonElement>(
            ".deliverable-previous",
        );
        const nextButton = dialog.querySelector<HTMLButtonElement>(
            ".deliverable-next",
        );
        const scroller = dialog.querySelector<HTMLElement>(".overflow-y-auto");
        let activeIndex = 0;

        const showDeliverable = (index: number) => {
            if (index < 0 || index >= details.length) return;
            activeIndex = index;
            scroller?.scrollTo({ top: 0, behavior: "instant" });

            details.forEach((detail, detailIndex) => {
                const active = detailIndex === index;
                detail.hidden = !active;
                const image = detail.querySelector("img");
                if (active && image) image.id = "deliverable-dialog-image";
                else image?.removeAttribute("id");

                const heading = detail.querySelector("h3");
                if (heading) {
                    if (active) heading.id = "deliverable-dialog-title";
                    else heading.removeAttribute("id");
                }
            });

            if (previousButton) previousButton.disabled = index === 0;
            if (nextButton) nextButton.disabled = index === details.length - 1;
        };

        triggers.forEach((trigger) => {
            trigger.addEventListener("click", () => {
                const index = Number(trigger.dataset.deliverable);
                showDeliverable(index);
                dialog.showModal();
                document.body.style.overflow = "hidden";
            });
        });

        dialog.querySelector(".deliverable-dialog-close")?.addEventListener(
            "click",
            () => dialog.close(),
        );
        previousButton?.addEventListener("click", () => {
            showDeliverable(activeIndex - 1);
        });
        nextButton?.addEventListener("click", () => {
            showDeliverable(activeIndex + 1);
        });
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener("close", () => {
            document.body.style.overflow = "";
        });
        document.addEventListener("astro:before-swap", () => {
            dialog.close();
        }, { once: true });
    }
</script>

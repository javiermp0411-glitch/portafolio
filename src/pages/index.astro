---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Hero from "../components/Hero.astro";
import Experience from "../components/Experience.astro";
import Projects from "../components/Projects.astro";
import SuitCase from "../components/icons/SuitCase.astro";
import Me from "../components/icons/Me.astro";
---

<Layout
    title="Portafolio de Javier Montero - Desarrollador FullStack"
    description="Portafolio personal de Javier"
>
    <SectionContainer
        id="home"
        class="py-16 max-w-200 mx-auto section md:py-36 scroll-m-20 w-full container px-4 sm:px-6 lg:px-0"
    >
        <Hero />
    </SectionContainer>

    <SectionContainer
        id="experience"
        class="py-16 max-w-200 mx-auto section md:py-36 scroll-m-20 w-full container px-4 sm:px-6 lg:px-0"
    >
        <h2 class="mb-8 flex items-center gap-x-3 text-2xl font-bold text-[#f5f5f5] sm:text-3xl">
            <Me class="size-6 text-gray-300 sm:size-7" />
            <span class="animate-text-gradient inline-flex bg-gradient-to-r from-gray-900 via-gray-600 to-gray-500 bg-[200%_auto] bg-clip-text text-transparent dark:from-[#f5f5f5] dark:via-slate-400 dark:to-neutral-400">
                Experiencia laboral
            </span>
        </h2>
        <Experience />
    </SectionContainer>

    <SectionContainer
        id="projects"
        class="py-16 max-w-200 mx-auto section md:py-36 scroll-m-20 w-full container px-4 sm:px-6 lg:px-0"
    >
        <h2 class="mb-8 flex items-center gap-x-3 text-2xl font-bold text-[#f5f5f5] sm:text-3xl">
            <SuitCase class="size-6 text-gray-300 sm:size-7" />
            <span class="animate-text-gradient inline-flex bg-gradient-to-r from-gray-900 via-gray-600 to-gray-500 bg-[200%_auto] bg-clip-text text-transparent dark:from-[#f5f5f5] dark:via-slate-400 dark:to-neutral-400">
                Proyectos
            </span>
        </h2>
        <Projects />
    </SectionContainer>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
---

<Layout
    title="Portafolio de Javier Montero - Desarrollador FullStack"
    description="Portafolio personal de Javier"
>
    <SectionContainer
        id="home"
        class="py-16 max-w-200 mx-auto section md:py-36 scroll-m-20 w-full container px-4 sm:px-6 lg:px-0"
    >
        <Hero />
    </SectionContainer>
    <SectionContainer
        id="projects"
        class="py-16 max-w-200 mx-auto section md:py-36 scroll-m-20 w-full container px-4 sm:px-6 lg:px-0"
    >
        <Projects />
    </SectionContainer>
</Layout>

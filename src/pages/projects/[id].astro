---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import GitHub from "../../components/icons/GitHub.astro";
import Link from "../../components/icons/Link.astro";
import ArrowBackUp from "../../components/icons/ArrowBackUp.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { id: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { title, description, company, pubDate, links, techstack, imgs, approach, deliverables } = project.data;
const { Content } = await render(project);

const formattedDate = new Date(pubDate).toLocaleDateString("es-ES", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<Layout title={`${title} - Javier Montero`} description={description}>
    <SectionContainer class="py-16 max-w-200 mx-auto section md:py-24 scroll-m-20 w-full container px-4 sm:px-6 lg:px-0">
        <div class="mb-6">
            <a
                href="/#projects"
                class="inline-flex items-center gap-2 text-xs md:text-sm text-gray-400 hover:text-white transition bg-white/5 border border-gray-800 px-3 py-1.5 rounded-full"
            >
                <ArrowBackUp class="size-4" />
                Volver a proyectos
            </a>
        </div>

        <div class="flex flex-col space-y-6 bg-transparent border border-gray-800 rounded-3xl p-6 sm:p-8 md:p-10 shadow-xl">
            {/* Header */}
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 flex-wrap mb-2">
                        <h1
                            transition:name={`title-${project.id}`}
                            class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#f5f5f5]"
                        >
                            {title}
                        </h1>
                        {company && (
                            <span class="px-3 py-1 text-xs md:text-sm font-medium bg-white/10 border border-white/10 rounded-full text-[#f5f5f5]/90">
                                {company}
                            </span>
                        )}
                    </div>
                    <time class="text-xs md:text-sm text-gray-400 font-medium">
                        Publicado el {formattedDate}
                    </time>
                </div>

                <div class="flex items-center gap-3 flex-wrap">
                    {links?.github && links.github !== "" && (
                        <a
                            href={links.github}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-2 text-xs md:text-sm font-medium text-gray-300 bg-white/5 border border-gray-700 hover:bg-white/10 hover:text-white px-4 py-2 rounded-full transition"
                        >
                            <GitHub class="size-4" />
                            Ver Código
                        </a>
                    )}
                    {links?.demo && links.demo !== "" && (
                        <a
                            href={links.demo}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-2 text-xs md:text-sm font-medium text-gray-900 bg-white hover:bg-gray-200 px-4 py-2 rounded-full transition shadow-sm"
                        >
                            <Link class="size-4" />
                            Sitio Web
                        </a>
                    )}
                </div>
            </div>

            {/* Description */}
            <p class="text-base sm:text-lg text-gray-300/90 leading-relaxed">
                {description}
            </p>

            {/* Main Image */}
            {imgs?.main && (
                <div class="overflow-hidden rounded-2xl border border-gray-800 my-4">
                    <img
                        src={imgs.main.src}
                        alt={`Vista principal de ${title}`}
                        class="w-full h-auto object-cover"
                    />
                </div>
            )}

            {/* Tech Stack */}
            <div class="flex flex-col gap-2 pt-2">
                <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Tecnologías</h3>
                <div class="flex items-center gap-2 flex-wrap">
                    {techstack.map((tech) => (
                        <span class="px-3 py-1 text-xs md:text-sm bg-white/5 border border-gray-700/60 rounded-full text-gray-300">
                            {tech}
                        </span>
                    ))}
                </div>
            </div>

            {/* Approach / Story */}
            {approach && (
                <div class="flex flex-col gap-2 pt-4 border-t border-gray-800">
                    <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Contexto / Enfoque</h3>
                    <p class="text-sm sm:text-base text-gray-300 leading-relaxed">
                        {approach}
                    </p>
                </div>
            )}

            {/* Deliverables */}
            {deliverables && deliverables.length > 0 && (
                <div class="flex flex-col gap-6 pt-4 border-t border-gray-800">
                    <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Entregables y Módulos</h3>
                    <div class="grid grid-cols-1 gap-6">
                        {deliverables.map((item, idx) => (
                            <div class="bg-white/[0.02] border border-gray-800 rounded-2xl p-5 flex flex-col gap-3">
                                <h4 class="text-base sm:text-lg font-semibold text-[#f5f5f5]">
                                    {idx + 1}. {item.title}
                                </h4>
                                <p class="text-sm text-gray-300/80">
                                    {item.description}
                                </p>
                                {item.img && (
                                    <div class="overflow-hidden rounded-xl border border-gray-800 my-2">
                                        <img src={item.img.src} alt={item.title} class="w-full h-auto object-cover" />
                                    </div>
                                )}
                                {item.metrics && item.metrics.length > 0 && (
                                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 mt-2">
                                        {item.metrics.map((metric) => (
                                            <div class="bg-white/5 border border-gray-800/80 rounded-xl p-3 text-center">
                                                <div class="text-lg font-bold text-white">{metric.value}</div>
                                                <div class="text-xs text-gray-400">{metric.label}</div>
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            )}

            {/* Markdown slot content if any */}
            <div class="prose prose-invert max-w-none pt-4 border-t border-gray-800">
                <Content />
            </div>
        </div>
    </SectionContainer>
</Layout>
